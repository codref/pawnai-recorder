# PawnAI Recorder configuration example

recording:
  rate: 16000
  chunk: 16000
  channel: 1
  chunk_size: 120
  file_extension: "flac"
  output_dir: "audio/"
  sample_width: 2

  # Timestamp / filename formatting
  # Placeholders available in timestamp_format:
  #   {ts}        - datetime string shaped by datetime_format (strftime)
  #   {device_id} - numeric audio device ID, or 'default' when not set
  #
  # Examples:
  #   "{ts}"                  -> 231015143022_01.flac          (default)
  #   "{ts}_dev{device_id}"   -> 231015143022_dev3_01.flac
  #   "{device_id}/{ts}"      -> would require output_dir to exist per device
  timestamp_format: "{ts}"
  datetime_format: "%y%m%d%H%M%S"

s3:
  bucket: "your-bucket-name"
  endpoint_url: "https://your-s3-compatible-endpoint"
  access_key: "your-access-key"
  secret_key: "your-secret-key"

  # Optional settings
  region: "us-east-1"
  prefix: "conversations"
  verify_ssl: true
  path_style: true

queue:
  # Master switch.  Set to false to disable all queue publishing without
  # removing the rest of the configuration.
  enabled: true

  # PawnQueue topic name.  The topic is created automatically on first use
  # if it does not already exist.
  topic: audio-chunks

  # Producer name registered in the queue registry.
  # Defaults to "pawnai-recorder" when omitted.
  producer_name: pawnai-recorder

  # ── transcribe-diarize command ─────────────────────────────────────────
  # Published once per uploaded audio chunk.
  # Omit this block to use the consumer-side defaults.
  transcribe_diarize:
    # When to publish the transcribe-diarize command.
    #   end_of_session (default) - one message with all chunk paths is sent
    #     after the client terminates the audio stream, just before analyze.
    #   per_chunk - a separate message is sent immediately after each chunk
    #     is uploaded (legacy behaviour).
    mode: end_of_session

    # Speaker-change detection sensitivity.
    # Lower values → more segments; higher values → fewer, longer segments.
    threshold: 0.2

    # Similarity threshold used when stitching speakers across consecutive
    # chunks of the same session.
    cross_file_threshold: 0.2

    # Inference device for Whisper / pyannote models.
    # One of: cpu | cuda | mps
    device: cpu

  # ── analyze command ────────────────────────────────────────────────────
  # Published once per recording session after all chunks are uploaded.
  # Omit this block to skip the analyze step.
  analyze:
    # Processing mode passed to the analyzer.
    # Examples: summary | action-items | transcript | qa
    mode: summary

    # LLM model identifier forwarded to the analyzer backend.
    model: gpt-4o

  # ── sync-siyuan command ────────────────────────────────────────────────
  # Published at the very end of each session to close the pipeline.
  # No parameters — always sent when the queue is enabled.

log:
  # Local JSONL recording log
  # The log file is created inside output_dir.
  # Each completed recording session appends three record types:
  #   session (event=start) - device, sample_rate, format, conversation_id
  #   chunk                 - file_path, duration_sec, s3_object_key, s3_uploaded
  #   session (event=end)   - total_duration_sec, chunk_count
  file: "recordings.jsonl"